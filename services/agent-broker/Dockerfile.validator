# Validator image (spec 30, FR-55).
#
# The validator now applies patches, so it needs a real git binary and CA roots;
# distroless cannot provide git. It still runs non-root with a read-only root
# filesystem, and all scratch work happens on the /tmp emptyDir.
FROM golang:1.26-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/validator ./cmd/validator

FROM alpine:3.21

RUN apk add --no-cache git ca-certificates \
    && adduser -D -u 65532 -h /tmp nonroot

COPY --from=build /out/validator /validator
USER 65532:65532
ENV HOME=/tmp
EXPOSE 8443
ENTRYPOINT ["/validator"]
