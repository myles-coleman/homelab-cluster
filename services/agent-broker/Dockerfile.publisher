# Publisher image (spec 30, FR-49).
#
# Runs on a trusted arm64 node and is the only component holding the GitHub App
# key. It needs a real git binary and CA roots to clone over HTTPS; everything
# else is the same non-root, no-shell posture as the validator.
FROM golang:1.26-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/publisher ./cmd/publisher

FROM alpine:3.21

RUN apk add --no-cache git ca-certificates \
    && adduser -D -u 65532 -h /tmp nonroot

COPY --from=build /out/publisher /publisher
USER 65532:65532
ENV HOME=/tmp
EXPOSE 8443
ENTRYPOINT ["/publisher"]
