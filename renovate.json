{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "pinDigests": true,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 5,
  "rebaseWhen": "conflicted",
  "postUpgradeTasks": {
    "commands": [
      "./scripts/render-helm-charts.sh",
      "./scripts/render-dist.sh"
    ],
    "fileFilters": [
      "manifests/cluster/**/helm-chart.yaml",
      "manifests/cluster/**/helmchart.yaml",
      "manifests/dist/**"
    ],
    "executionMode": "update"
  },
  "ignorePaths": [
    "manifests/dist/**",
    "manifests/bootstrap/**",
    "manifests/cluster/**/helm-chart.yaml",
    "manifests/cluster/**/helmchart.yaml",
    "manifests/cluster/_template/**"
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "manifests/cluster/**/values.yaml",
        "manifests/cluster/**/deployment.yaml",
        "manifests/cluster/**/*-deployment.yaml"
      ],
      "semanticCommitType": "fix"
    }
  ]
}
