# Pinned tool versions for the dist/ render and verification pipeline.
#
# This file is the single source of truth. scripts/render-dist.sh and
# .github/workflows/dist-verify.yml both read it, so a version difference
# between a contributor's machine and CI cannot silently re-serialize dist/.
#
# Changing a version re-serializes the whole rendered tree. Treat a version
# bump as its own pull request whose diff is the re-render and nothing else.

# kustomize version used to build manifests/cluster/<service> and dist/<service>.
# Must match `kustomize version` locally. A minor bump rewrites quoting and
# ordering across every file in dist/, which makes an unrelated PR unreadable.
KUSTOMIZE_VERSION=5.8.1

# helm / helmfile versions used to regenerate manifests/cluster/*/helm-chart.yaml.
# helm-chart.yaml files are generated, never hand-edited. These versions were
# verified to reproduce the committed helm-chart.yaml byte-identically for
# longhorn and signoz before any values override was added.
HELM_VERSION=3.20.2
HELMFILE_VERSION=1.5.0

# go-containerregistry's crane, used only by scripts/pin-digests.sh to resolve
# tags to digests. It is not used by the renderer or by CI.
CRANE_VERSION=0.21.6

# PyYAML, used by scripts/verify-dist.py. CI installs exactly this version.
PYAML_VERSION=6.0.2
